{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "error"
  },
  "ignorePatterns": ["_site", "node_modules"],
  "overrides": [
    {
      "files": ["eleventy.config.*.js"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
